# Copia este archivo a .env y completa la password. NUNCA subas .env a git.
# Usuario y password son los de barriodigital-infra/mq/.env (RABBITMQ_DEFAULT_USER y RABBITMQ_DEFAULT_PASS).

# Nodos del clúster separados por coma. Por defecto localhost:5672: en local solo el nodo 1 publica puerto.
# Dentro de la misma red de compose que el clúster: rabbitmq-1:5672,rabbitmq-2:5672
RABBIT_ADDRESSES=localhost:5672
# Por defecto barriodigital.
RABBIT_USER=barriodigital
# Sin valor por defecto. Sin ella la app arranca, pero no se conecta y el health queda DOWN.
RABBIT_PASSWORD=
